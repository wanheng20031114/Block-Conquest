extends RefCounted
## Authored lessons: one concept, one real practice, then a clear result.
const BUILDING := preload("res://scripts/block_war/war_building.gd")
const IDS: Array[String] = ["basics", "interface", "house", "tower", "forge", "energy", "morale", "recruit", "drum", "shield", "fire"]
const TITLES: Array[String] = ["第一道军令", "读懂战场", "住宅：壮大军团", "炮塔：守住路口", "铁匠铺：武装全军", "能量塔：积攒技力", "士气：越战越勇", "征召军令：补足兵力", "疾行战鼓：抢先增援", "防护罩：守住前哨", "天降冲击：截断敌军"]
const SUMMARIES: Array[String] = ["按住、拖动、松开，夺取第一座据点。", "认识界面分区，练习比例、移动与缩放。", "看懂驻军与生产，亲手完成一次升级。", "增援炮塔，再观察它自动击退来敌。", "夺取铁匠铺，认识全军的攻防加成。", "夺取能量塔，观察技力恢复变快。", "通过占领升到一星，理解三种战斗加成。", "在住宅满员时征召额外士兵，再出发扩张。", "把加速区域放在援军的必经路线上。", "先给前哨套上护盾，再抵挡来敌。", "对密集敌军施放火焰，并避开自己人。"]

static func title(id: String) -> String:
	return TITLES[IDS.find(id)]

static func summary(id: String) -> String:
	return SUMMARIES[IDS.find(id)]

static func ids() -> Array[String]:
	return IDS.duplicate()

static func minutes(id: String) -> String:
	return "约 2 分钟" if id in ["interface", "house", "recruit"] else "约 1 分钟"

static func step(heading: String, body: String, goal: String, action: String, focus: String, extra: Dictionary = {}) -> Dictionary:
	var result := {"title": heading, "body": body, "goal": goal, "action": action, "focus": focus}
	result.merge(extra)
	return result

static func steps(id: String) -> Array[Dictionary]:
	match id:
		"basics": return [
			step("欢迎来到练兵地", "这里没有倒计时，也没有自由行动的电脑。每次讲解出现，整个战场都会暂停；鼠标示范仍会继续。\n先跟着松鼠指挥官发出第一道军令。", "认识自己的住宅", "read", "building:0"),
			step("旗帜看归属，数字看驻军", "金色旗帜是你的建筑，灰色旗帜是中立据点。己方与中立建筑上方会显示驻军，敌方驻军不公开。\n士兵真正离开大门时，驻军数字才会逐批减少。", "看清己方住宅与中立据点", "read", "buildings"),
			step("按住 → 拖过去 → 松开", "在金色住宅上按住鼠标左键，拖到灰色住宅，再松开。出现连线后，就可以发出进攻命令。\n默认派出一半士兵；拖错时按右键取消。", "从金色住宅拖到灰色住宅，夺取它", "capture", "buildings", {"source": 0, "target": 1}),
			step("第一座新据点到手", "旗帜变为金色，说明占领成功。剩下的进攻士兵会成为这里的驻军。\n住宅还会继续生产，让你的军团慢慢壮大。", "已完成第一次真实占领", "read", "building:1")]
		"interface": return [
			step("从上往下读懂战场", "顶部显示双方总兵力、战线对比和本局时间。总兵力包含建筑驻军和行军部队。\n不必记住所有数字，先看哪一方拥有优势。", "认识顶部战况", "read", "top"),
			step("指挥官与士气", "下方左边是你的指挥官，右边是敌方。顶部战况旁的星星表示士气。\n占领和胜利会鼓舞部队；后面的专门课程会带你升起第一颗星。", "认识指挥官与士气区", "read", "morale"),
			step("四个技能，共用一条技力", "下方是松鼠的四个技能，技能旁的能量条是技力。技能会消耗技力，也有各自的冷却。\n可以拖动技能图标施放，拖动时按右键取消。", "认识技能与技力区", "read", "skills"),
			step("留多少兵，由你决定", "左侧的百分比控制本次派出多少可用驻军。25% 适合少量试探和增援，100% 会派出全部可用驻军。\n现在点击 25%，练习保留大部分守军。", "点击左侧 25% 出兵比例", "ratio", "ratios"),
			step("拉近，看清队伍", "把鼠标移到地图空白处，滚动滚轮缩放视野。\n拖着建筑时滚轮会改出兵比例，所以缩放前要先松手。", "在地图空白处滚动滚轮", "zoom", "world"),
			step("移动视野，找到需要的战场", "在地图空白处按住鼠标中键，拖动一小段，再松开。也可以使用方向键移动。\n视野有边界，不会越过地图外围。", "按住中键拖动地图，或用方向键移动", "pan", "world")]
		"house": return [
			step("住宅负责生产士兵", "住宅会自动生产驻军。1 级住宅每秒生产 1 人，生产上限为 30；达到上限后停止自然增长。\n增援和征召可以超过生产上限，已经拥有的士兵不会消失。", "观察住宅与驻军数字", "read", "building:0"),
			step("升级让住宅更强", "点击自己的住宅，建筑旁会出现操作按钮。1 级升到 2 级需要驻军，并经过 %d 秒施工。\n点击向上的升级按钮，把住宅升到 2 级；施工中仍保留原来的能力。" % BUILDING.upgrade_duration(0, 1), "选中住宅，点击升级并等待完成", "upgrade", "upgrade", {"target": 0}),
			step("升级已经完成", "2 级住宅每秒生产 1.25 人，生产上限提高到 50。\n旁边的改建按钮可以把建筑改成其他用途；改建也会消耗驻军，接下来逐一认识它们。", "认识升级和改建的取舍", "read", "selection")]
		"tower": return [
			step("炮塔自动攻击射程内的敌军", "炮塔周围柔和的阵营色虚线，就是攻击范围。敌方行军部队进入范围后，炮塔会自动开火。\n炮塔不生产士兵，需要住宅提供增援。", "认识炮塔与射程", "read", "building:1"),
			step("先给炮塔补充守军", "把后方金色住宅拖到己方炮塔。拖向自己的建筑表示增援，不会发生战斗。\n发出军令后，一小队敌军才会开始进攻。", "从住宅拖到己方炮塔进行增援", "reinforce_tower", "buildings", {"source": 0, "target": 1}),
			step("观察炮塔守住路口", "你的增援正在抵达，炮塔会自己瞄准和射击。\n这一步不用重复点击，看看它如何帮助驻军守住据点。", "等待炮塔开火并击退这一波敌军", "tower_defense", "building:1"),
			step("炮塔需要守军，也需要布局", "炮塔已经守住了路口。把它放在敌军必经之路，再用住宅持续增援，比孤立地建在远处更有效。", "已完成炮塔防守", "read", "building:1")]
		"forge": return [
			step("铁匠铺让全军更能打", "铁匠铺不生产士兵，但能给本阵营提供攻击和防御加成。\n它不提供移动速度加成，士气和技能才会改变移动表现。", "认识铁匠铺的全军作用", "read", "building:1"),
			step("把铁匠铺变成自己的", "从住宅派兵夺取灰色铁匠铺。它变为己方后，加成便会应用到你的军团。", "从住宅拖到中立铁匠铺并占领", "capture", "buildings", {"source": 0, "target": 1}),
			step("加成已经生效", "现在你拥有了一座铁匠铺。它是支援建筑，需要其他据点保护；失去它，也会失去对应的全军加成。\n不必向它反复点击，持有期间会自动生效。", "已获得铁匠铺攻防加成", "read", "building:1")]
		"energy": return [
			step("技力是施放技能的资源", "能量塔会提高技力恢复速度，但不生产士兵。多座能量塔可以叠加恢复收益，收益逐渐递减。\n本关预先留出技力空间，方便看见恢复的变化。", "认识能量塔和下方技力条", "read", "energy"),
			step("争取更多施法机会", "派兵夺取中立能量塔。建筑变为金色以后，观察下方技力条的恢复。", "从住宅拖到能量塔并占领", "capture", "buildings", {"source": 0, "target": 1}),
			step("技力正在更快恢复", "现在先不施放技能，看看能量条继续增长。技力不会超过上限，满值时不必继续等待。\n更快恢复意味着你能更早准备下一次技能。", "观察占领后的技力增长 5 点", "energy_watch", "skills"),
			step("生产与支援，各有分工", "住宅养兵，炮塔守路，铁匠铺提高攻防，能量塔支援技能。\n建筑可以改建，选择取决于你当前缺少哪一种能力。", "已认识全部四种建筑", "read", "building:1")]
		"morale": return [
			step("士气会影响整个军团", "星星不只是战绩装饰。士气可以提高防御、攻击和移动速度。\n这段练习从接近一星的局面开始，完成一次占领来鼓舞部队。", "通过占领升到一星士气", "read", "morale"),
			step("用行动鼓舞部队", "灰色铁匠铺没有驻军，派出少量士兵便能占领。\n占领后看顶部己方的星星，士气达到 500 点就会升为一星。", "派兵占领铁匠铺，获得第一颗星", "capture", "buildings", {"source": 0, "target": 1}),
			step("第一颗星的力量", "一星士气提供：防御 120%、攻击 105%、移动速度 110%。更高等级会继续增强，最高五星。\n进攻伤亡、失去据点和长期没有有效行动都会损失士气。保护士兵、及时巩固战果同样重要。", "确认一星士气带来的三种加成", "read", "morale")]
		"recruit": return [
			step("征召军令：满员后继续补兵", "这座 1 级住宅已达到 30 人的自然生产上限，附近却还有据点需要争夺。\n松鼠的一技能能在短时间内额外征召士兵，并突破自然生产上限。", "在满员住宅上使用征召军令", "read", "building:0"),
			step("拖动第一个技能到住宅", "按住下方第一个技能，拖到金色住宅上再松开。\n它需要己方住宅；拖错时按右键取消，不会消耗技力。", "将征召军令拖到己方住宅", "cast_building", "skill:0", {"skill": 0, "target": 0}),
			step("先看清技能带来的结果", "征召正在继续，驻军已经能超过 30。\n等至少额外征召 16 人，再带着更充足的兵力出发。", "等待住宅驻军达到 46 人", "recruit_watch", "building:0"),
			step("把补充的兵力用于扩张", "现在从住宅向灰色据点派兵。半数出兵既能进攻，也能留下守军。\n技能的价值不只是数字变大，而是让下一步行动更有把握。", "派兵占领前方据点", "capture", "buildings", {"source": 0, "target": 1})]
		"drum": return [
			step("疾行战鼓：让增援更早到达", "前方据点等待增援，住宅与它之间有一段路。\n先派兵，再把战鼓区域放在队伍经过的位置，能缩短这段行军时间。", "先向前方据点派出援军", "dispatch", "buildings", {"source": 0, "target": 1}),
			step("把战鼓放在脚下的路上", "第二个技能作用于地面。把图标拖到金色行军队伍附近，松手展开疾行区域。\n圈内自己的部队会提速，离开后恢复；加速圈不会跟随部队移动。", "将疾行战鼓放到己方行军队伍经过处", "cast_ground", "skill:1", {"skill": 1, "army": 0}),
			step("观察增援经过加速区域", "你已经展开了战鼓区域。接下来观察至少一名士兵真正获得加速，并抵达前方据点。", "让受加速的援军抵达据点", "haste_arrival", "building:1")]
		"shield": return [
			step("防护罩：先保护，再迎敌", "前哨很快将承受一波敌军冲击。松鼠第三个技能能短时间提高己方建筑的守备。\n本关会等你成功施法后才放出敌军，让你安心学习。", "为前哨准备防护罩", "read", "building:1"),
			step("给金色前哨套上防护罩", "将第三个技能拖到金色前哨，看到目标高亮后松开，护盾便会展开。\n这是建筑防护技能，不能把它放在路上的士兵或空地上。", "把防护罩拖到金色前哨", "cast_building", "skill:2", {"skill": 2, "target": 1}),
			step("观察防护罩减少损失", "敌军开始进攻。守备提高后，每个进攻士兵能造成的驻军损失会减少。\n护盾并非无敌，也不会永久持续，施放时机应靠近交战。", "在护盾保护下承受攻击并守住前哨", "shield_defense", "building:1")]
		"fire": return [
			step("天降冲击：对付密集军阵", "一队敌军正在向前哨推进。第四个技能能在一小片区域点燃火焰，适合切断密集的行军队伍。\n火焰会杀伤敌我双方行军士兵，施放前先看清自己人在哪里。", "避开己军，瞄准密集敌军", "read", "army:1"),
			step("拖到敌军密集的路段", "按住第四个技能，拖向青绿色敌军中央，再松手。\n范围不大，优先覆盖密集队列；瞄错了可以右键取消。", "用天降冲击消灭至少 3 名敌军", "fire_hit", "skill:3", {"skill": 3, "army": 1}),
			step("你已经掌握基础指挥", "增兵用于扩张，战鼓用于赶路，护盾用于守点，火焰用于截断敌军。\n结合四种建筑和士气，选择合适的行动。随时可以回到入门教程重练任意一关。", "完成松鼠的四项技能练习", "read", "skills")]
	return []
