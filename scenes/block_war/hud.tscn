theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.64, 0.73, 0.66, 1)
text = "部队从建筑周围就近出发、抵达，无需绕到正门；越过沟壑仍须走桥。\n双方部队互相穿行，留意炮塔与火焰。占领敌方全部据点并消灭援军即可获胜。"

[node name="Heading2" type="Label" parent="UI/HelpOverlay/HelpCard"]
