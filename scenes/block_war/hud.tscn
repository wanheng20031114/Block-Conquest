[sub_resource type="Shader" id="RoundPortrait"]
code = "shader_type canvas_item;
void fragment(){
vec4 face = texture(TEXTURE,UV);
face.a *= 1.0-smoothstep(0.47,0.5,length(UV-vec2(0.5)));
COLOR = face;
}"

