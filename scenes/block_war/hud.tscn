[node name="Heading0" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 179.0
offset_right = 594.0
offset_bottom = 217.0
text = "01  拖一条线，出发"
mouse_filter = 2
theme_type_variation = &"MenuHeading"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Detail0" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 226.0
offset_right = 584.0
offset_bottom = 329.0
text = "从自己的建筑拖向目标，松手派兵。\n进攻敌方与中立据点，增援盟友。\n1 / 2 / 3 / 4 切换比例；拖动时滚轮也能调兵。"
mouse_filter = 2
theme_type_variation = &"MenuMuted"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Heading1" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 658.0
offset_top = 179.0
offset_right = 1208.0
offset_bottom = 217.0
text = "02  看准地形"
mouse_filter = 2
theme_type_variation = &"MenuHeading"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Detail1" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 658.0
offset_top = 226.0
offset_right = 1198.0
offset_bottom = 329.0
text = "部队会沿地形行军，跨越沟壑需要走桥。\n提防炮塔和火焰，双方行军部队可以互相穿行。\n占领敌方全部据点并消灭援军，就能获胜。"
mouse_filter = 2
theme_type_variation = &"MenuMuted"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Heading2" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 354.0
offset_right = 594.0
offset_bottom = 392.0
text = "03  经营据点"
mouse_filter = 2
theme_type_variation = &"MenuHeading"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Detail2" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 401.0
offset_right = 584.0
offset_bottom = 504.0
text = "住宅自动产兵；升级提高产速与停产人口。\n改建花费 20 人，升级与改建都需 10 秒。\n施工期间保留原功能；失守会降级并中断施工。"
mouse_filter = 2
theme_type_variation = &"MenuMuted"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Heading3" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 658.0
offset_top = 354.0
offset_right = 1208.0
offset_bottom = 392.0
text = "04  用好四个技能"
mouse_filter = 2
theme_type_variation = &"MenuHeading"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Detail3" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 658.0
offset_top = 401.0
offset_right = 1198.0
offset_bottom = 504.0
text = "拖动图标，或按住 Q / W / E / R 瞄准，松手施放。\n电脑同样受到技力与冷却限制。\n右键或无效落点取消，不扣技力；火攻不分敌我。"
mouse_filter = 2
theme_type_variation = &"MenuMuted"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

[node name="Heading4" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 530.0
offset_right = 1196.0
offset_bottom = 568.0
text = "05  攻防与视野"
mouse_filter = 2
theme_type_variation = &"MenuHeading"
autowrap_mode = 2
theme_override_font_sizes/font_size = 26

[node name="Detail4" type="Label" parent="UI/HelpOverlay/HelpCard"]
layout_mode = 0
offset_left = 44.0
offset_top = 577.0
offset_right = 1164.0
offset_bottom = 680.0
text = "铁匠铺每座攻击 +10%；炮塔守备 5% / 10% / 15%，先加减再乘兵力。\n屏幕边缘或中键拖动来移动镜头；滚轮缩放；Esc 暂停。"
mouse_filter = 2
theme_type_variation = &"MenuMuted"
autowrap_mode = 2
theme_override_font_sizes/font_size = 18

