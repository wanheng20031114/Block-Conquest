[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/block_war/war_skill_tooltip.gd" id="script"]
[ext_resource type="Theme" path="res://assets/ui/block_war/skill_tooltip_theme.tres" id="theme"]
[ext_resource type="Font" path="res://assets/ui/medieval/fonts/title.tres" id="title"]
[ext_resource type="Font" path="res://assets/ui/block_war/fonts/numbers.tres" id="numbers"]

[node name="SkillTooltip" type="VBoxContainer"]
mouse_filter = 2
theme = ExtResource("theme")
theme_override_constants/separation = 7
script = ExtResource("script")

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_fonts/font = ExtResource("title")
theme_override_font_sizes/font_size = 24
text = "征召军令"

[node name="Shortcut" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_fonts/font = ExtResource("numbers")
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.40, 0.43, 0.31, 1)
text = "[Q]"
vertical_alignment = 1

[node name="Rule" type="ColorRect" parent="."]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(0.42, 0.43, 0.29, 0.32)

[node name="Description" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/line_spacing = 5
text = "拖至自己或盟友住宅，松手施放。\n每秒征召 4 人，持续 6 秒，不叠加。"

[node name="Stats" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.40, 0.38, 0.25, 1)
text = "消耗 30 技力   ·   冷却 35 秒"

[node name="Footer" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="State" type="Label" parent="Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "可以施放"

[node name="Energy" type="Label" parent="Footer"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.40, 0.43, 0.31, 1)
text = "当前技力  100 / 100"
