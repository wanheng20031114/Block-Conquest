theme_override_colors/font_color = Color(0.74, 0.80, 0.68, 1)
theme_override_font_sizes/font_size = 16

[node name="Preview" type="Control" parent="Margin/Column/Body/Pages/Room/MapBoard/MapColumn"]
unique_name_in_owner = true
layout_mode = 2
