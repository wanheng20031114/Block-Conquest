[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/tutorial/tutorial_annotations.gd" id="script"]
[ext_resource type="Font" path="res://assets/ui/medieval/fonts/body.tres" id="font"]

[sub_resource type="Shader" id="BadgeShader"]
code = "shader_type canvas_item;
render_mode unshaded;

// Match architecture/population_badge.gdshader: equal circular petals,
// central disk, porcelain rim and subtle lower shadow.
float flower_distance(vec2 p) {
    float petals = length(abs(p) - vec2(0.38)) - 0.46;
    return min(petals, length(p) - 0.34);
}

void fragment() {
    vec2 p = (UV - vec2(0.5)) * 2.0;
    float distance = flower_distance(p);
    float aa = max(fwidth(distance), 0.002);
    float face = 1.0 - smoothstep(-aa, aa, distance);
    float shadow = (1.0 - smoothstep(-0.02, 0.08, flower_distance(p - vec2(0.0, 0.055)))) * 0.20;
    float alpha = face + shadow * (1.0 - face);
    float rim = smoothstep(-0.06, 0.0, distance);
    vec3 porcelain = mix(vec3(1.0, 0.995, 0.975), vec3(0.84, 0.86, 0.82), rim * 0.24);
    COLOR = vec4(mix(vec3(0.10, 0.15, 0.12), porcelain, face / max(alpha, 0.001)), alpha);
}
"

[sub_resource type="ShaderMaterial" id="BadgeMaterial"]
shader = SubResource("BadgeShader")

[sub_resource type="StyleBoxFlat" id="Paper"]
bg_color = Color(0.984, 0.976, 0.915, 1)
