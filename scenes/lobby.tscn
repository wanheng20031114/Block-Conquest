[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/menu_entrance.gd" id="entrance"]
[ext_resource type="Theme" path="res://assets/ui/block_war/menu_theme.tres" id="theme"]
[ext_resource type="Shader" path="res://assets/ui/block_war/lobby_backdrop.gdshader" id="backdrop"]
[ext_resource type="PackedScene" path="res://scenes/ui/lobby_diorama.tscn" id="diorama"]

[sub_resource type="ShaderMaterial" id="Background"]
shader = ExtResource("backdrop")

[node name="Lobby" type="Control" groups=["animated_menu"]]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="MenuEntrance" type="Node" parent="."]
script = ExtResource("entrance")
sections = Array[NodePath]([NodePath("Margin/Column/Body/Welcome/Brand"), NodePath("Margin/Column/Body/Welcome/Menu/BlockWarMode"), NodePath("Margin/Column/Body/Welcome/Menu/OnlineMode"), NodePath("Margin/Column/Body/Welcome/Menu/Tutorial"), NodePath("Margin/Column/Body/Welcome/Menu/Codex"), NodePath("Margin/Column/Body/Welcome/Menu/Settings"), NodePath("Margin/Column/Body/Welcome/Menu/Quit"), NodePath("Margin/Column/Footer")])

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
material = SubResource("Background")

[node name="Diorama" parent="." instance=ExtResource("diorama")]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 88
theme_override_constants/margin_right = 48
theme_override_constants/margin_top = 64
theme_override_constants/margin_bottom = 30

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 28

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
size_flags_vertical = 3
theme_override_constants/separation = 45

[node name="Welcome" type="VBoxContainer" parent="Margin/Column/Body"]
layout_mode = 2
custom_minimum_size = Vector2(450, 0)
size_flags_vertical = 4
theme_override_constants/separation = 40
mouse_filter = 2

[node name="Brand" type="VBoxContainer" parent="Margin/Column/Body/Welcome"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column/Body/Welcome/Brand"]
unique_name_in_owner = true
layout_mode = 2
text = "积木战争"
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 106

[node name="Menu" type="VBoxContainer" parent="Margin/Column/Body/Welcome"]
layout_mode = 2
mouse_filter = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(400, 0)
theme_override_constants/separation = 18

[node name="BlockWarMode" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 84)
mouse_default_cursor_shape = 2
text = "开始战争    →"
theme_type_variation = &"MenuPrimary"
theme_override_font_sizes/font_size = 30
metadata/ui_sound = &"order"
metadata/ui_motion_hover_scale = 1.018

[node name="OnlineMode" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 66)
mouse_default_cursor_shape = 2
text = "多人联机    →"
theme_override_font_sizes/font_size = 25
metadata/ui_sound = &"order"
metadata/ui_motion_hover_scale = 1.018

[node name="Tutorial" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 66)
mouse_default_cursor_shape = 2
text = "入门教程    →"
theme_override_font_sizes/font_size = 25
metadata/ui_sound = &"order"
metadata/ui_motion_hover_scale = 1.018

[node name="Codex" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 66)
mouse_default_cursor_shape = 2
text = "战地手册    图鉴"
metadata/ui_motion_hover_scale = 1.018

[node name="Settings" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 66)
mouse_default_cursor_shape = 2
text = "设置"
metadata/ui_motion_hover_scale = 1.018

[node name="Quit" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(400, 66)
mouse_default_cursor_shape = 2
text = "退出游戏"
theme_type_variation = &"MenuBack"
metadata/ui_sound = &"cancel"
metadata/ui_motion_hover_scale = 1.018

[node name="Message" type="Label" parent="Margin/Column/Body/Welcome"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(450, 24)
text = ""
theme_type_variation = &"MenuMuted"
autowrap_mode = 2

[node name="Footer" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 24
alignment = 2

[node name="Version" type="Label" parent="Margin/Column/Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "v1.3.5"
theme_type_variation = &"MenuMuted"
