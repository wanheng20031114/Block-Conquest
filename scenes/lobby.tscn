[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="script"]
[ext_resource type="Script" path="res://scripts/ui/menu_entrance.gd" id="entrance"]
[ext_resource type="Theme" path="res://assets/ui/block_war/menu_theme.tres" id="theme"]
[ext_resource type="Shader" path="res://assets/ui/block_war/menu_backdrop.gdshader" id="backdrop"]
[ext_resource type="Texture2D" path="res://assets/ui/block_war/commanders/squirrel.png" id="squirrel"]
[ext_resource type="Texture2D" path="res://assets/ui/block_war/commanders/rabbit.png" id="rabbit"]
[ext_resource type="Texture2D" path="res://assets/ui/block_war/commanders/bear.png" id="bear"]
[ext_resource type="Texture2D" path="res://assets/ui/block_war/commanders/frog.png" id="frog"]

[sub_resource type="ShaderMaterial" id="Background"]
shader = ExtResource("backdrop")

[sub_resource type="StyleBoxFlat" id="Stage"]
bg_color = Color(0.98, 0.97, 0.86, 0.42)
corner_radius_top_left = 250
corner_radius_top_right = 230
corner_radius_bottom_left = 210
corner_radius_bottom_right = 260
corner_detail = 32

[node name="Lobby" type="Control" groups=["animated_menu"]]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="MenuEntrance" type="Node" parent="."]
script = ExtResource("entrance")
sections = Array[NodePath]([NodePath("Margin/Column/Body/Welcome/Brand"), NodePath("Margin/Column/Body/Partners"), NodePath("Margin/Column/Body/Welcome/Menu/BlockWarMode"), NodePath("Margin/Column/Body/Welcome/Menu/Settings"), NodePath("Margin/Column/Body/Welcome/Menu/Quit"), NodePath("Margin/Column/Footer")])

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
material = SubResource("Background")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 120
theme_override_constants/margin_right = 100
theme_override_constants/margin_top = 76
theme_override_constants/margin_bottom = 46

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Body" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 45

[node name="Welcome" type="VBoxContainer" parent="Margin/Column/Body"]
layout_mode = 2
custom_minimum_size = Vector2(495, 0)
size_flags_vertical = 4
theme_override_constants/separation = 34

[node name="Brand" type="VBoxContainer" parent="Margin/Column/Body/Welcome"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margin/Column/Body/Welcome/Brand"]
unique_name_in_owner = true
layout_mode = 2
text = "积木战争"
theme_type_variation = &"MenuTitle"
theme_override_font_sizes/font_size = 94

[node name="Menu" type="VBoxContainer" parent="Margin/Column/Body/Welcome"]
layout_mode = 2
size_flags_horizontal = 0
custom_minimum_size = Vector2(380, 0)
theme_override_constants/separation = 14

[node name="BlockWarMode" type="Button" parent="Margin/Column/Body/Welcome/Menu"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(380, 76)
mouse_default_cursor_shape = 2
text = "开始战争    →"
theme_type_variation = &"MenuPrimary"
