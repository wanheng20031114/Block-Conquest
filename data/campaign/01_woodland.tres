[gd_resource type="Resource" script_class="CampaignStage" format=3]

[ext_resource type="Script" path="res://scripts/campaign/campaign_stage.gd" id="stage"]

[resource]
script = ExtResource("stage")
number = 1
title = "水间花池"
region = "西境 · 紫阳花海"
description = "沿紫阳花与曲水之间的石桥向东推进，夺取花池中央的空置建筑。\n兔子守军占据两座二级住宅，却总是攒满技力后才慢悠悠地考虑施放技能。"
map_id = "flower_pool"
opponent_commander = &"rabbit"
opponent_lazy_skills = true
