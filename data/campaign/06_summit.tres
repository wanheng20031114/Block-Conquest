[gd_resource type="Resource" script_class="CampaignStage" format=3]

[ext_resource type="Script" path="res://scripts/campaign/campaign_stage.gd" id="stage"]

[resource]
script = ExtResource("stage")
number = 6
title = "雪冠要塞"
region = "北境 · 雪山与要塞"
description = "盘山小径尽头，要塞矗立于皑皑群峰之间。\n从林野而来的远征，将在雪冠之下抵达终点。"
