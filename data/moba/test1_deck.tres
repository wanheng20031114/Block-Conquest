[resource]
script = ExtResource("script")
cards = Array[ExtResource("card_script")]([ExtResource("spears"), ExtResource("archers"), ExtResource("swords"), ExtResource("guards"), ExtResource("crossbows"), ExtResource("muskets"), ExtResource("knights"), ExtResource("scouts"), ExtResource("elephant"), ExtResource("cannon")])
opening_hand = PackedStringArray("spears", "archers", "swords", "guards", "cannon")
