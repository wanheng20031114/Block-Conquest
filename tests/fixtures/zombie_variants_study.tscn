[connection signal="timeout" from="RepeatAction" to="." method="_on_repeat_action_timeout"]
[connection signal="item_selected" from="Overlay/Interface/Selector" to="." method="select_model"]
[connection signal="pressed" from="Overlay/Interface/Controls/Idle" to="." method="show_idle"]
[connection signal="pressed" from="Overlay/Interface/Controls/Walk" to="." method="show_walk"]
[connection signal="pressed" from="Overlay/Interface/Controls/Strike" to="." method="show_strike"]
[connection signal="pressed" from="Overlay/Interface/Controls/Team" to="." method="cycle_team"]
[connection signal="pressed" from="Overlay/Interface/Controls/Rally" to="." method="show_rally"]
[connection signal="toggled" from="Overlay/Interface/Controls/Loop" to="." method="_on_loop_toggled"]
